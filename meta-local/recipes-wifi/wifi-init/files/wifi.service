# WiFi connection for Orange Pi 3 (AP6256 / brcmfmac).
#
# wifi-connect tries STA first (/data/wifi.conf). On missing config
# or failed association/DHCP it starts a setup AP (wifi-ap-start) and exits 0
# so dependent units (Weston) are not blocked. wifi-roam runs only in STA mode.

[Unit]
Description=WiFi connection (brcmfmac / AP6256)
Documentation=file:///data/wifi.conf
Wants=network.target
After=network.target systemd-modules-load.service sys-subsystem-net-devices-wlan0.device
RequiresMountsFor=/data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/wifi-connect
ExecStop=/usr/sbin/wifi-ap-stop
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
