#!/bin/sh
# JSON status of the last / in-progress WiFi connection test.
set -eu

echo "Content-Type: application/json; charset=utf-8"
echo "Cache-Control: no-store"
echo ""

if [ -f /run/wifi-test-result ]; then
	cat /run/wifi-test-result
	echo
else
	printf '{"status":"idle","connected":false,"ssid":"","reason":"","ip":""}\n'
fi
