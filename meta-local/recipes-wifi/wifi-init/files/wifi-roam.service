# Band preference companion for wifi.service (see /usr/sbin/wifi-roam).
#
# priority= in wpa_supplicant.conf selects 5G on first association, but does
# not leave an already-established weak 5G link for 2.4. This unit performs
# RSSI failover with hysteresis. PartOf=wifi.service — shared lifecycle with
# connect.

[Unit]
Description=WiFi band preference (prefer 5G, fallback to 2.4 on weak RSSI)
Documentation=file:///etc/wpa_supplicant.conf
After=wifi.service
Requires=wifi.service
PartOf=wifi.service

[Service]
Type=simple
ExecStart=/usr/sbin/wifi-roam
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
