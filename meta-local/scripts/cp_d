#!/bin/bash
# Flash the latest deployed WIC image to a block device (default /dev/sda).

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)

IMAGE="core-image-khepri-orange-pi-3.rootfs"
SRC="${DEPLOY:-$ROOT/build-orangepi3/tmp/deploy/images/orange-pi-3}"
DEST="${DEST:-/dev/sda}"
WIC_GZ="${SRC}/${IMAGE}.wic.gz"
WIC="${IMAGE}.wic"

if [ ! -f "${WIC_GZ}" ]; then
	echo "Missing image: ${WIC_GZ}" >&2
	exit 1
fi

WIC_GZ_REAL=$(readlink -f "${WIC_GZ}")
echo "image: ${WIC_GZ_REAL}"
echo "created: $(stat -c '%y' "${WIC_GZ_REAL}" | cut -d. -f1)"
echo "dest: ${DEST}"

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT
cd "$WORKDIR"

echo "cp"
cp "${WIC_GZ}" .

echo "gunzip"
gunzip -f "${IMAGE}.wic.gz"

echo "dd"
sudo dd if="${WIC}" of="${DEST}" bs=4M status=progress

echo "sync"
sync

echo "done"
printf '\a'
