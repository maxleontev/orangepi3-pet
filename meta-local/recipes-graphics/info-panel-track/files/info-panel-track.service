[Unit]
Description=HDMI camera + servo track panel
After=weston.service
BindsTo=weston.service
PartOf=weston.service

[Service]
Type=simple
User=weston
Group=weston
# /dev/video* is typically root:video; weston user is in video via weston-init.
SupplementaryGroups=wayland video kmem
# CAP_SYS_RAWIO + kmem: map 300a000.pwm and update duty without sun4i CTRL glitches.
AmbientCapabilities=CAP_SYS_RAWIO
Environment=XDG_RUNTIME_DIR=/run
Environment=WAYLAND_DISPLAY=wayland-0
Environment=MESA_LOADER_DRIVER_OVERRIDE=lima
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Prefer QVGA over the GL3510 hub (override with INFO_PANEL_CAMERA_SIZE).
Environment=INFO_PANEL_CAMERA_SIZE=320x240
# Pan servo on HW PWM0 (PD22). Set INFO_PANEL_SERVO=0 to disable.
Environment=INFO_PANEL_SERVO=1
# Root: wait for Wayland, fix video node perms, disable USB autosuspend.
ExecStartPre=+/bin/sh -c 'i=0; while [ ! -S /run/wayland-0 ] && [ $i -lt 50 ]; do i=$((i+1)); sleep 0.2; done; [ -S /run/wayland-0 ]'
ExecStartPre=+/bin/sh -c 'for n in /dev/video*; do [ -e "$n" ] || continue; chgrp video "$n" 2>/dev/null; chmod 660 "$n" 2>/dev/null; done; true'
ExecStartPre=+/bin/sh -c 'echo -1 > /sys/module/usbcore/parameters/autosuspend 2>/dev/null; echo 128 > /sys/module/usbcore/parameters/usbfs_memory_mb 2>/dev/null; true'
# Root: export HW PWM0 only if servo will be used (INFO_PANEL_SERVO!=0).
# chmod 660 /dev/mem so weston+kmem can mmap PWM regs (stock is 640, group read-only).
ExecStartPre=+/bin/sh -c 'case "${INFO_PANEL_SERVO:-1}" in 0|n|N|f|F) exit 0;; esac; CHIP=/sys/class/pwm/pwmchip0; P=$CHIP/pwm0; [ -d "$CHIP" ] || exit 0; [ -d "$P" ] || echo 0 > $CHIP/export; i=0; while [ ! -e "$P/duty_cycle" ] && [ $i -lt 40 ]; do i=$((i+1)); sleep 0.05; done; chmod 666 "$P/duty_cycle" "$P/enable" "$P/period" "$P/polarity" 2>/dev/null; chmod 660 /dev/mem 2>/dev/null; true'
ExecStart=/usr/bin/info-panel-track
Restart=on-failure
RestartSec=2

[Install]
WantedBy=weston.service
