#!/bin/bash

IMAGE="core-image-khepri-orange-pi-3.rootfs"
SRC="../build-orangepi3/tmp/deploy/images/orange-pi-3"
WIC_GZ="${SRC}/${IMAGE}.wic.gz"
WIC="${IMAGE}.wic"

if [ ! -f "${WIC_GZ}" ]; then
	echo "Missing image: ${WIC_GZ}" >&2
	exit 1
fi

WIC_GZ_REAL=$(readlink -f "${WIC_GZ}")
echo "image: ${WIC_GZ_REAL}"
echo "created: $(stat -c '%y' "${WIC_GZ_REAL}" | cut -d. -f1)"

echo "rm"
rm -f "${WIC}" "${WIC}.gz"

echo "cp"
cp "${WIC_GZ}" .

echo "gunzip"
gunzip -f "${IMAGE}.wic.gz"

echo "dd"
sudo dd if="${WIC}" of=/dev/sda bs=4M status=progress

echo "sync"
sync

echo "rm"
rm -f "${WIC}"

echo "done"
printf '\a'